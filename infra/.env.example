# Copiar a infra/.env y no versionar ese archivo:
#   cp .env.example .env
# Docker Compose, ejecutado desde infra/, lee .env para sustituir ${...}.

# MySQL 8.4 — el usuario de aplicación es el mismo DB_USER / DB_PASSWORD de env.example
MYSQL_ROOT_PASSWORD=mesatech-root
MYSQL_DATABASE=catalogo
MYSQL_USER=mesatech
MYSQL_PASSWORD=mesatech

# RabbitMQ 4.0. El entrypoint arma el vhost mesatech y tres usuarios.
# catalogo solo publica. solicitudes solo consume. mesatech-ui es la consola :15672.
# guest existe para el vhost / y no tiene permisos en mesatech.
RABBITMQ_CATALOGO_PASSWORD=catalogo-dev
RABBITMQ_SOLICITUDES_PASSWORD=solicitudes-dev
RABBITMQ_UI_PASSWORD=mesatech-ui-dev
