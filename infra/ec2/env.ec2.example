# Plantilla para EC2 — copiar a ~/mesatech.env (NO subir a Git)

export ENTRA_ISSUER_URI="https://login.microsoftonline.com/<TENANT_ID>/v2.0"
export ENTRA_AUDIENCE="<API_CLIENT_ID>"

export MS_SOLICITUDES_URL="http://127.0.0.1:8081"
export MS_CATALOGO_URL="http://127.0.0.1:8082"

export DB_USER="mesatech"
export DB_PASSWORD="<cambiar-en-produccion>"

# DB_URL es distinta por microservicio. No la exportes una sola vez en este archivo
# compartido: los dos JAR leerían la misma base.
#   ms-catalogo:     jdbc:mysql://<IP_PRIVADA_DB>:3306/catalogo
#   ms-solicitudes:  jdbc:mysql://<IP_PRIVADA_DB>:3306/solicitudes
# Si MySQL corre en la misma máquina, omite DB_URL: el default de
# application.properties es localhost y la base correcta de cada servicio.
# Credenciales del contenedor (infra/.env en la EC2, no este archivo):
# MYSQL_ROOT_PASSWORD, MYSQL_USER, MYSQL_PASSWORD, RABBITMQ_DEFAULT_*.

# CORS BFF: localhost directo al :8080. Vacío si React → API Gateway (CORS solo en Gateway).
export CORS_ALLOWED_ORIGINS="http://localhost:3000"
# export CORS_ALLOWED_ORIGINS=""
