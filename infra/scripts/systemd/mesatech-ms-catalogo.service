[Unit]
Description=MesaTech ms-catalogo :8082
After=network.target docker.service

[Service]
Type=simple
User=ubuntu
EnvironmentFile=/home/ubuntu/mesatech.env
# Si MySQL no está en localhost, descomenta y pon la IP privada de la EC2 de datos.
# Environment=DB_URL=jdbc:mysql://<IP_PRIVADA_DB>:3306/catalogo
# Este JAR publica. No uses el usuario de ms-solicitudes.
# Environment=RABBITMQ_HOST=127.0.0.1
# Environment=RABBITMQ_PORT=5672
# Environment=RABBITMQ_VHOST=mesatech
# Environment=RABBITMQ_USER=catalogo
# Environment=RABBITMQ_PASSWORD=catalogo-dev
WorkingDirectory=/home/ubuntu/apps
ExecStart=/usr/bin/java -jar /home/ubuntu/apps/ms-catalogo.jar
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
